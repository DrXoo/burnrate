POSTGRES_DB=burnrate
POSTGRES_USER=burnrate
# Use a strong, unique password. Postgres is NOT published to the host (see
# docker-compose.yml), so it is only reachable by the app over the compose
# network -- but this password still protects the data if that ever changes.
# NOTE: changing this only takes effect on a *fresh* volume. To rotate on an
# existing database:  docker compose exec postgres psql -U burnrate -d burnrate
#                     -c "ALTER USER burnrate WITH PASSWORD '<new>';"
# then update this value AND the password inside DATABASE_URL below.
# Avoid "$" (docker compose eats it) and URL-reserved chars (@ : / ? #).
POSTGRES_PASSWORD=change-me-to-something-strong

BACKEND_PORT=8000
WEB_PORT=3000

DATABASE_URL=postgresql+psycopg://burnrate:burnrate@postgres:5432/burnrate
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
# IANA timezone the owner lives in. Everything BurnRate calls "today" or "this
# month" -- the dashboard, /summary, budget activation -- is resolved here, so a
# wrong value reports yesterday after local midnight. An unknown name fails the
# boot rather than reporting the wrong day.
APP_TIMEZONE=UTC
# The web container proxies /api/v1 to the backend, so the browser calls the API
# same-origin and needs no entry here. These only matter for `vite dev` (:5173)
# or for hitting the backend port directly.
APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
# Base URL of the Web UI the Enable Banking callback redirects back to after linking.
WEB_BASE_URL=http://localhost:3000

# --- App login (required) -------------------------------------------------
# BurnRate refuses every protected endpoint until these are set. Generate both
# with:  docker compose run --rm backend python -m burnrate.generate_auth_secrets
# (or, in the backend venv:  python -m burnrate.generate_auth_secrets)
#
# NOTE: docker compose interpolates "$" in .env values, which corrupts the
# Argon2 hash (it is full of "$"). In THIS file (loaded by compose) you must
# double every "$" in the hash, e.g.  $$argon2id$$v=19$$m=65536,...  The
# generator prints a ready-to-paste compose-escaped line for you.
AUTH_PASSWORD_HASH=
AUTH_SECRET_KEY=
# How long a session stays valid, in seconds (default 7 days). The window slides
# forward on each authenticated request.
AUTH_SESSION_MAX_AGE=604800
# Send the session cookie only over HTTPS. Keep true in production. Set to false
# ONLY for local http development, or the browser will drop the cookie.
AUTH_COOKIE_SECURE=true
# Failed-login throttle: lock a client for AUTH_LOGIN_LOCKOUT_SECONDS after this
# many wrong passwords.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_SECONDS=300
# Per-endpoint throttle for the bank calls (start auth, list banks, manual sync)
# so a looping client can't burn Enable Banking quota or trip bank-side limits.
BANK_RATE_LIMIT_MAX_REQUESTS=20
BANK_RATE_LIMIT_WINDOW_SECONDS=60

# Encrypts the bank session token stored in the database, so a stolen dump or
# backup contains no usable bank access. Generated by
# `python -m burnrate.generate_auth_secrets`. Required.
# WARNING: back this key up. If you lose it the stored tokens cannot be
# decrypted and you must reconnect the bank.
BANK_TOKEN_ENCRYPTION_KEY=

ENABLE_BANKING_APP_ID=replace-me
ENABLE_BANKING_PRIVATE_KEY=
ENABLE_BANKING_PRIVATE_KEY_PATH=/run/secrets/enable-banking.pem
ENABLE_BANKING_REDIRECT_URL=https://mi-cueva-gold.duckdns.org/enable_banking_items/callback
ENABLE_BANKING_ENVIRONMENT=production
ENABLE_BANKING_API_BASE_URL=https://api.enablebanking.com
ENABLE_BANKING_TIMEOUT_SECONDS=30
ENABLE_BANKING_MAX_RETRIES=3
ENABLE_BANKING_RETRY_BACKOFF_SECONDS=0.5

SYNC_CRON=*/30 * * * *

# Telegram secondary interface (read-only). Leave TELEGRAM_BOT_TOKEN empty to disable the bot.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat ids allowed to use the bot. Messages from other
# chats are ignored. Message the bot once and check the logs to find your chat id.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_POLL_TIMEOUT_SECONDS=30
