POSTGRES_DB=burnrate
POSTGRES_USER=burnrate
POSTGRES_PASSWORD=burnrate
POSTGRES_PORT=5432

BACKEND_PORT=8000
WEB_PORT=3000

DATABASE_URL=postgresql+psycopg://burnrate:burnrate@postgres:5432/burnrate
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.2.33:3000

ENABLE_BANKING_APP_ID=replace-me
ENABLE_BANKING_PRIVATE_KEY=
ENABLE_BANKING_PRIVATE_KEY_PATH=/run/secrets/enable-banking.pem
ENABLE_BANKING_REDIRECT_URL=https://mi-cueva-gold.duckdns.org/enable_banking_items/callback
ENABLE_BANKING_ENVIRONMENT=production
ENABLE_BANKING_API_BASE_URL=https://api.enablebanking.com
ENABLE_BANKING_TIMEOUT_SECONDS=30
ENABLE_BANKING_MAX_RETRIES=3
ENABLE_BANKING_RETRY_BACKOFF_SECONDS=0.5

SYNC_CRON=*/30 * * * *
